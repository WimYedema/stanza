{
  "name": "phrase-vscode",
  "displayName": "Phrase",
  "description": "A visual editor for Phrase documents (.phrase.md), bound to the Markdown file.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "publisher": "phrase-local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "Phrase",
      "properties": {
        "phrase.exportOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Write the DOCX of a document into the build folder of its project when the document is saved."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "phrase.editor",
        "displayName": "Phrase Editor",
        "selector": [
          {
            "filenamePattern": "*.phrase.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "phrase.styles",
        "displayName": "Phrase Styles",
        "selector": [
          {
            "filenamePattern": "*.yaml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "phrase.editStyles",
        "title": "Phrase: Edit Styles"
      },
      {
        "command": "phrase.newProject",
        "title": "Phrase: New Project"
      },
      {
        "command": "phrase.newDocument",
        "title": "Phrase: New Document"
      },
      {
        "command": "phrase.importWord",
        "title": "Phrase: Import Word Document"
      },
      {
        "command": "phrase.adoptMarkdown",
        "title": "Phrase: Adopt Markdown File"
      },
      {
        "command": "phrase.goToHeading",
        "title": "Phrase: Go to Heading"
      },
      {
        "command": "phrase.openInWord",
        "title": "Phrase: Open in Word",
        "icon": "$(link-external)"
      }
    ],
    "keybindings": [
      {
        "command": "phrase.goToHeading",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == phrase.editor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "phrase.openInWord",
          "when": "activeCustomEditorId == phrase.editor && !isWeb && !remoteName",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "@phrase/core": "*",
    "@phrase/css": "*",
    "@phrase/editor": "*",
    "@phrase/format": "*",
    "@phrase/project": "*"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "fflate": "^0.8.3"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "package": "npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license --out ../../phrase.vsix",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  }
}

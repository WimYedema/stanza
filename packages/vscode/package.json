{
  "name": "stanza-docs",
  "displayName": "Stanza Docs",
  "description": "A visual editor for Stanza documents (.stanza.md), bound to the Markdown file.",
  "version": "0.1.0",
  "private": true,
  "publisher": "ienfald",
  "preview": true,
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WimYedema/stanza.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/WimYedema/stanza#readme",
  "bugs": {
    "url": "https://github.com/WimYedema/stanza/issues"
  },
  "keywords": [
    "markdown",
    "docx",
    "word",
    "documentation",
    "technical writing",
    "editor"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "Stanza",
      "properties": {
        "stanza.exportOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Write the DOCX of a document into the build folder of its project when the document is saved."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "stanza.editor",
        "displayName": "Stanza Editor",
        "selector": [
          {
            "filenamePattern": "*.stanza.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "stanza.styles",
        "displayName": "Stanza Styles",
        "selector": [
          {
            "filenamePattern": "*.yaml"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "stanza.outline",
          "name": "Stanza",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "stanza.editStyles",
        "title": "Stanza: Edit Styles"
      },
      {
        "command": "stanza.newProject",
        "title": "Stanza: New Project"
      },
      {
        "command": "stanza.newDocument",
        "title": "Stanza: New Document"
      },
      {
        "command": "stanza.initializeDocumentList",
        "title": "Stanza: Initialize Document List"
      },
      {
        "command": "stanza.moveDocumentUp",
        "title": "Stanza: Move Document Up"
      },
      {
        "command": "stanza.moveDocumentDown",
        "title": "Stanza: Move Document Down"
      },
      {
        "command": "stanza.regroupDocument",
        "title": "Stanza: Move Document to Group"
      },
      {
        "command": "stanza.importWord",
        "title": "Stanza: Import Word Document"
      },
      {
        "command": "stanza.pullReview",
        "title": "Stanza: Pull Review Comments"
      },
      {
        "command": "stanza.adoptMarkdown",
        "title": "Stanza: Adopt Markdown File"
      },
      {
        "command": "stanza.addAgentInstructions",
        "title": "Stanza: Add Agent Instructions"
      },
      {
        "command": "stanza.goToHeading",
        "title": "Stanza: Go to Heading"
      },
      {
        "command": "stanza.goToLine",
        "title": "Stanza: Go to Line"
      },
      {
        "command": "stanza.makeReference",
        "title": "Stanza: Make Reference"
      },
      {
        "command": "stanza.openInWord",
        "title": "Stanza: Open in Word",
        "icon": "$(link-external)"
      }
    ],
    "keybindings": [
      {
        "command": "stanza.goToHeading",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == stanza.editor"
      },
      {
        "command": "stanza.goToLine",
        "key": "ctrl+g",
        "when": "activeCustomEditorId == stanza.editor"
      },
      {
        "command": "stanza.makeReference",
        "key": "ctrl+shift+k",
        "when": "activeCustomEditorId == stanza.editor"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "stanza.initializeDocumentList",
          "when": "view == stanza.outline && viewItem == stanzaProject",
          "group": "stanza@1"
        },
        {
          "command": "stanza.moveDocumentUp",
          "when": "view == stanza.outline && viewItem == stanzaDocument",
          "group": "stanza@2"
        },
        {
          "command": "stanza.moveDocumentDown",
          "when": "view == stanza.outline && viewItem == stanzaDocument",
          "group": "stanza@3"
        },
        {
          "command": "stanza.regroupDocument",
          "when": "view == stanza.outline && viewItem == stanzaDocument",
          "group": "stanza@4"
        }
      ],
      "commandPalette": [
        {
          "command": "stanza.moveDocumentUp",
          "when": "false"
        },
        {
          "command": "stanza.moveDocumentDown",
          "when": "false"
        },
        {
          "command": "stanza.regroupDocument",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "stanza.makeReference",
          "when": "webviewId == 'stanza.editor' && webviewSection == 'editor'",
          "group": "stanza@1"
        }
      ],
      "editor/title": [
        {
          "command": "stanza.openInWord",
          "when": "activeCustomEditorId == stanza.editor && !isWeb && !remoteName",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "@stanza/core": "*",
    "@stanza/css": "*",
    "@stanza/editor": "*",
    "@stanza/format": "*",
    "@stanza/project": "*"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "fflate": "^0.8.3"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "package": "vsce package --no-dependencies --out stanza.vsix",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  }
}

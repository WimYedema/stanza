{
  "name": "phrase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && npm run build --workspace phrase-vscode",
    "typecheck:tests": "npm run typecheck:tests --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm run typecheck:tests && npm run test && npm run lint && npm run format:check && npm run docs:check",
    "docs:fix": "node packages/cli/dist/main.js format --assign-ids docs",
    "docs:check": "node packages/cli/dist/main.js validate docs && node packages/cli/dist/main.js format --check --assign-ids docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
